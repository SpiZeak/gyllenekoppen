{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"css": {
		"formatter": {
			"enabled": true,
			"indentStyle": "tab",
			"indentWidth": 4
		},
		"linter": {
			"enabled": true
		},
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		}
	},
	"json": {
		"formatter": {
			"enabled": true,
			"indentStyle": "tab",
			"indentWidth": 4
		}
	},
	"files": {
		"includes": [
			"**",
			"!public",
			"!static/tailwind.css",
			"!static/fonts",
			"!templates",
			"!css/theme.css",
			"!.wrangler",
			"!.kilo"
		]
	},
	"overrides": [
		{
			"includes": ["templates/**"],
			"linter": { "enabled": false },
			"assist": { "enabled": false }
		}
	]
}
